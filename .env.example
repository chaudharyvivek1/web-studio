# WebStudio environment variables
# Copy to .env.local and adjust. Every variable is optional in development.

# Server port (npm start reads PORT, default 3000)
PORT=3000

# ── Access control ──────────────────────────────────────────────────────────
# Single shared token that gates every route behind /login. Minimum 8 characters.
# Leave unset in development to run open. In production, an unset token makes the
# app refuse to serve (503) unless WEBSTUDIO_ALLOW_OPEN=1 is also set.
WEBSTUDIO_ACCESS_TOKEN=

# Explicitly allow an unprotected production deployment. Only use this when the
# instance genuinely is not reachable by anyone else.
# WEBSTUDIO_ALLOW_OPEN=1

# ── Secret storage ──────────────────────────────────────────────────────────
# Key material for encrypting stored authentication profiles (cookies and
# tokens) at rest with AES-256-GCM. Falls back to WEBSTUDIO_ACCESS_TOKEN.
# Changing this makes previously stored profiles unreadable.
WEBSTUDIO_SECRET=

# ── Storage ─────────────────────────────────────────────────────────────────
# Where the SQLite database lives. Point at a mounted volume in production.
# Default: ./data
WEBSTUDIO_DATA_DIR=

# Where captured mirrors are written. Point at a mounted volume in production.
# Default: ./tmp/downloads locally, $TMPDIR/downloads on serverless (ephemeral).
WEBSTUDIO_DOWNLOAD_DIR=

# ── Integrations ────────────────────────────────────────────────────────────
# owner/name of the GitHub repository whose star count appears in the navbar.
# Leave unset to hide the badge.
GITHUB_REPO=

# ── Browser automation ──────────────────────────────────────────────────────
# Set to 0 to vendor Playwright browsers into the project instead of ~/.cache
# PLAYWRIGHT_BROWSERS_PATH=0

# Force the manual-login browser to run headless. A manual login is impossible
# without a window, so only set this on a server.
# WEBSTUDIO_LOGIN_HEADLESS=1

# ── Platform ────────────────────────────────────────────────────────────────
# Set by the hosting platform, not by you. When VERCEL or NOW_BUILDER is present
# WebStudio switches to the pure-Node mirror strategy and ephemeral storage.
# VERCEL=
# NOW_BUILDER=
