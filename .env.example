# WebStudio environment variables
# Copy to .env.local and adjust. Every variable is optional.

# Server port (npm start reads PORT, default 3000)
PORT=3000

# owner/name of the GitHub repository whose star count appears in the navbar.
# Leave unset to hide the badge.
GITHUB_REPO=

# Set to 0 to vendor Playwright browsers into the project instead of ~/.cache
# PLAYWRIGHT_BROWSERS_PATH=0

# Set by the hosting platform, not by you. When VERCEL or NOW_BUILDER is
# present, WebStudio switches to the pure-Node mirror strategy and stores
# mirrors under $TMPDIR instead of ./tmp.
# VERCEL=
# NOW_BUILDER=

